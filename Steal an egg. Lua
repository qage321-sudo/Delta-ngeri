-- REMOTE PATH RESOLVER (cari remote dengan fallback)
-- ==================================================
local RemoteCache = {}

local function findRemote(namePattern)
    if RemoteCache[namePattern] and RemoteCache[namePattern].Parent then
        return RemoteCache[namePattern]
    end
    -- Coba path eksplisit dulu
    local paths = {
        ReplicatedStorage:FindFirstChild("StealAnEgg"),
        ReplicatedStorage:FindFirstChild("Remotes"),
        ReplicatedStorage,
    }
    for _, base in ipairs(paths) do
        if base then
            local remote = base:FindFirstChild(namePattern, true)
            if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
                RemoteCache[namePattern] = remote
                return remote
            end
        end
    end
    -- Fallback: scan semua remote yang nama lower-nya mengandung pattern
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            if v.Name:lower():find(namePattern:lower()) then
                RemoteCache[namePattern] = v
                return v
            end
        end
    end
    return nil
end

