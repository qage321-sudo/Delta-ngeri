-- EGG SCANNER (CACHED)
-- ==================================================
local function isEgg(v) return v:IsA("BasePart") and (v.Name:lower():find("egg") or v:FindFirstChild("EggId") or v:GetAttribute("Rarity")) end

local eggCache = {}
local eggCacheTime = 0
local function getAllEggs()
    if tick() - eggCacheTime < 1 then return eggCache end
    local out = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if isEgg(v) then table.insert(out, v) end
    end
    eggCache = out
    eggCacheTime = tick()
    return out
end

local function getRarity(egg) local r=egg:GetAttribute("Rarity") or "Common"; return RARITY[r] and r or "Common" end
local function rarityColor(egg) return (RARITY[getRarity(egg)] or RARITY.Common).color end
local function rarityTier(egg) return (RARITY[getRarity(egg)] or RARITY.Common).tier end
local function getWeight(egg) return egg:GetAttribute("Weight") or 0 end

local function getNearestEgg(filter)
    local nearest,dist=nil,math.huge
    local char=LP.Character; if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root=char.HumanoidRootPart
    for _,v in ipairs(getAllEggs()) do
        if (filter=="All" or getRarity(v)==filter) and getWeight(v)>=State.FilterWeight then
            local d=(v.Position-root.Position).Magnitude
            if d<dist then dist=d; nearest=v end
        end
    end
    return nearest
end
local function getHighestTierEgg(filter)
    local best,tier=nil,-1
    for _,v in ipairs(getAllEggs()) do
        if (filter=="All" or getRarity(v)==filter) and getWeight(v)>=State.FilterWeight then
            local t=rarityTier(v); if t>tier then tier=t; best=v end
        end
    end
    return best
end

-- INTERNAL FLY
local flyBV, flyBG, flyConn
local function startFly()
    if flyBV then return end
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    flyBV=Instance.new("BodyVelocity"); flyBV.MaxForce=Vector3.new(1e5,1e5,1e5); flyBV.Velocity=Vector3.zero; flyBV.Parent=hrp
    flyBG=Instance.new("BodyGyro"); flyBG.MaxTorque=Vector3.new(1e5,1e5,1e5); flyBG.P=1e4; flyBG.Parent=hrp
    flyConn=RunService.RenderStepped:Connect(function()
        if not flyBV or not flyBV.Parent then return end
        local dir=Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir+=workspace.CurrentCamera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir-=workspace.CurrentCamera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir-=workspace.CurrentCamera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir+=workspace.CurrentCamera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir+=Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir-=Vector3.yAxis end
        flyBV.Velocity=dir.Magnitude>0 and dir.Unit*60 or Vector3.zero
        flyBG.CFrame=workspace.CurrentCamera.CFrame
    end)
end
local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn=nil end
    if flyBV then flyBV:Destroy(); flyBV=nil end
    if flyBG then flyBG:Destroy(); flyBG=nil end
end

