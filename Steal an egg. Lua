-- EGG SCANNER (WORKSPACE.Eggs.[BIOME]_Egg)
-- ==================================================
local function isEgg(v)
    if not v:IsA("BasePart") and not v:IsA("Model") then return false end
    local name = v.Name:lower()
    if name:find("egg") then return true end
    if v:GetAttribute("Weight") then return true end
    if v.Parent and v.Parent.Name:lower():find("egg") then return true end
    return false
end

local eggCache = {}
local eggCacheTime = 0
local function getAllEggs()
    if tick() - eggCacheTime < 1 then return eggCache end
    local out = {}
    -- Cari folder Eggs dulu
    local eggsFolder = Workspace:FindFirstChild("Eggs", true)
    if eggsFolder then
        for _, v in ipairs(eggsFolder:GetDescendants()) do
            if isEgg(v) then table.insert(out, v) end
        end
    end
    -- Fallback scan workspace
    if #out == 0 then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if isEgg(v) then table.insert(out, v) end
        end
    end
    eggCache = out
    eggCacheTime = tick()
    return out
end

local function getBiomeFromEgg(egg)
    -- Coba dari nama: Volcano_Egg -> Volcano
    local n = egg.Name
    local biome = n:match("^(%a+)_Egg") or n:match("^(%a+)_")
    if biome and BIOMES[biome] then return biome end
    -- Coba dari parent
    if egg.Parent then
        local pn = egg.Parent.Name
        local b = pn:match("^(%a+)_Egg") or pn:match("^(%a+)")
        if b and BIOMES[b] then return b end
    end
    -- Coba attribute
    local ba = egg:GetAttribute("Biome")
    if ba and BIOMES[ba] then return ba end
    return "Unknown"
end

local function getRarity(egg)
    local r = egg:GetAttribute("Rarity") or egg:GetAttribute("rarity")
    if type(r) == "string" and RARITY[r] then return r end
    return "Common"
end
local function rarityColor(egg) return (RARITY[getRarity(egg)] or RARITY.Common).color end
local function rarityTier(egg) return (RARITY[getRarity(egg)] or RARITY.Common).tier end
local function getWeight(egg) return egg:GetAttribute("Weight") or egg:GetAttribute("weight") or 0 end

local function getNearestEgg(filterRarity, filterBiome)
    local nearest,dist=nil,math.huge
    local char=LP.Character; if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root=char.HumanoidRootPart
    for _,v in ipairs(getAllEggs()) do
        local okR = (filterRarity=="All" or getRarity(v)==filterRarity)
        local okB = (filterBiome=="All" or getBiomeFromEgg(v)==filterBiome)
        if okR and okB and getWeight(v)>=State.FilterWeight then
            local pos = v:IsA("BasePart") and v.Position or (v:FindFirstChild("HumanoidRootPart") and v.HumanoidRootPart.Position)
            if pos then
                local d=(pos-root.Position).Magnitude
                if d<dist then dist=d; nearest=v end
            end
        end
    end
    return nearest
end
local function getHighestTierEgg(filterRarity, filterBiome)
    local best,tier=nil,-1
    for _,v in ipairs(getAllEggs()) do
        local okR = (filterRarity=="All" or getRarity(v)==filterRarity)
        local okB = (filterBiome=="All" or getBiomeFromEgg(v)==filterBiome)
        if okR and okB and getWeight(v)>=State.FilterWeight then
            local t=rarityTier(v); if t>tier then tier=t; best=v end
        end
    end
    return best
end

