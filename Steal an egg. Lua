local espFolder=new("Folder",{Name="ESP_Folder"},ScreenGui)
local espCache={}; local tracerCache={}
local function clearESP()
    for _,v in pairs(espCache) do pcall(function() v:Destroy() end) end
    for _,v in pairs(tracerCache) do pcall(function() v:Remove() end) end
    espCache={}; tracerCache={}
end
local function makeESP(part)
    local color=rarityColor(part); local rarity=getRarity(part)
    if State.SilentSteal then return end
    local box = Instance.new("BoxHandleAdornment", espFolder)
    box.Adornee=part; box.Size=part.Size+Vector3.new(0.5,0.5,0.5)
    box.Transparency=0.5; box.Color3=color; box.AlwaysOnTop=true; box.ZIndex=5
    table.insert(espCache,box)
    local bill=Instance.new("BillboardGui",espFolder); bill.Size=UDim2.fromOffset(180,45); bill.StudsOffsetWorldSpace=Vector3.new(0,3,0); bill.AlwaysOnTop=true; bill.Adornee=part
    local lbl=Instance.new("TextLabel",bill); lbl.Size=UDim2.fromScale(1,1); lbl.BackgroundTransparency=1; lbl.TextColor3=color; lbl.Font=Enum.Font.GothamBold; lbl.TextSize=12; lbl.TextStrokeTransparency=0.5
    local dist=""
    if State.ESPDistance then local char=LP.Character; if char and char:FindFirstChild("HumanoidRootPart") then dist=string.format(" | %.0fm",(part.Position-char.HumanoidRootPart.Position).Magnitude) end end
    lbl.Text=part.Name.."\n"..rarity.." | "..tostring(getWeight(part)).."kg"..dist
    table.insert(espCache,bill)
    if State.ESPTracer then local line=Drawing.new("Line"); line.Thickness=2; line.Color=color; line.Transparency=0.8; tracerCache[part]=line end
end

